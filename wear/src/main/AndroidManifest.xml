<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.type.watch"
        android:required="true" />

    <!-- The heart rate sensor. Android 16 gates it behind the Health Connect
         READ_HEART_RATE permission; earlier releases behind BODY_SENSORS. The
         background pair keeps the sensor readable once the screen is closed. -->
    <uses-permission
        android:name="android.permission.BODY_SENSORS"
        android:maxSdkVersion="35" />
    <uses-permission
        android:name="android.permission.BODY_SENSORS_BACKGROUND"
        android:maxSdkVersion="35" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />

    <!-- The step counter. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- The RFCOMM listener the phone pings. Legacy pair up to API 30, runtime grant from 31. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- The listener outlives the activity as a connectedDevice foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Keeps the processor up in bedtime mode, worn and off the charger, so the
         accelerometer's 48-second buffer is read before it overflows. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenVitalsWear">

        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <service
            android:name=".WearAppService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|health" />

        <!-- Restarts the phone link after a reboot or an update; no-op without the Bluetooth grant. -->
        <receiver
            android:name=".WearBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Allow or Block from the phone request notification. -->
        <receiver
            android:name=".WearPhoneConfirmReceiver"
            android:exported="false" />

        <!-- The metric tiles: each reads what the recorders stored and starts no sensor. -->
        <service
            android:name=".HeartRateTileService"
            android:description="@string/tile_heart_rate_description"
            android:exported="true"
            android:icon="@drawable/ic_metric_heart_rate"
            android:label="@string/tile_heart_rate_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview_heart_rate" />
        </service>
        <service
            android:name=".StepsTileService"
            android:description="@string/tile_steps_description"
            android:exported="true"
            android:icon="@drawable/ic_metric_steps"
            android:label="@string/tile_steps_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview_steps" />
        </service>
        <service
            android:name=".DistanceTileService"
            android:description="@string/tile_distance_description"
            android:exported="true"
            android:icon="@drawable/ic_metric_distance"
            android:label="@string/tile_distance_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview_distance" />
        </service>
        <service
            android:name=".ActiveCaloriesTileService"
            android:description="@string/tile_active_calories_description"
            android:exported="true"
            android:icon="@drawable/ic_metric_active_calories"
            android:label="@string/tile_active_calories_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview_active_calories" />
        </service>
        <service
            android:name=".FloorsTileService"
            android:description="@string/tile_floors_description"
            android:exported="true"
            android:icon="@drawable/ic_metric_floors"
            android:label="@string/tile_floors_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview_floors" />
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
